# 1. Directory Browsing band karein (Security ke liye)
Options -Indexes

# 2. Default Index page set karein
DirectoryIndex index.php

# 3. URL se .php hatane ke liye (Optional)
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# 4. Sensitive files ko block karein taake koi aapka password na dekh sake
<FilesMatch "^\.env|db\.php|config">
    Order allow,deny
    Deny from all
</FilesMatch>

# 5. 404 Error handle karein
ErrorDocument 404 /index.php